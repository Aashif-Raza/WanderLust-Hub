<% layout('/layouts/boilerplate') -%>

<% layout('/layouts/boilerplate') -%>
<script>
  let mapToken = "<%= process.env.MAP_TOKEN %>"
  let listing = <%- JSON.stringify(listing) %>;
</script>

<div class="row mt-3">
  <!-- Left Column: Listing Details -->
  <div class="col-12 col-md-7 offset-md-1">
    <h3><%= listing.title %></h3>
    <div class="card show-card listing-card">
    <img
      src="<%= listing.image.url %>"
      class="card-img-top show-img"
      alt="listing_image"
    />
    <div class="card-body">
      <p class="card-text">Owned by <i> <%= listing.owner.username %></i></p>
      <p class="card-text"><%= listing.description %></p>
      <p class="card-text">
        &#8377;<%= listing.price.toLocaleString("en-IN") %>
      </p>
      <p class="card-text"><%= listing.country %></p>
      <p class="card-text"><%= listing.location %></p>
    </div>
  </div>

  <% if(currUser && listing.owner._id.equals(currUser._id)) { %>
  <div class="btns mb-4">
    <a
      href="/listings/<%=listing._id%>/edit"
      class="btn btn-dark col-2 edit-btn"
      >Edit</a
    >
    <form method="POST" action="/listings/<%=listing._id%>?_method=DELETE">
      <button class="btn btn-danger ms-3 del-btn">Delete</button>
    </form>
  </div>
  <% } %>

  <div class="mb-3">
    <% if(currUser) { %>
    <hr />
    <h4>Leave a Review</h4>
    <form
      action="/listings/<%= listing.id %>/reviews"
      method="POST"
      novalidate
      class="needs-validation"
    >

      <div class="mb-3 mt-3">
        <label for="rating" class="form-label">Rating</label>
        <fieldset class="starability-slot">
          <input
            type="radio"
            id="no-rate"
            class="input-no-rate"
            name="review[rating]"
            value="1"
            checked
            aria-label="No rating."
          />
          <input
            type="radio"
            id="first-rate1"
            name="review[rating]"
            value="1"
          />
          <label for="first-rate1" title="Terrible">1 star</label>
          <input
            type="radio"
            id="first-rate2"
            name="review[rating]"
            value="2"
          />
          <label for="first-rate2" title="Not good">2 stars</label>
          <input
            type="radio"
            id="first-rate3"
            name="review[rating]"
            value="3"
          />
          <label for="first-rate3" title="Average">3 stars</label>
          <input
            type="radio"
            id="first-rate4"
            name="review[rating]"
            value="4"
          />
          <label for="first-rate4" title="Very good">4 stars</label>
          <input
            type="radio"
            id="first-rate5"
            name="review[rating]"
            value="5"
          />
          <label for="first-rate5" title="Amazing">5 stars</label>
        </fieldset>
      </div>

      <div class="mb-3 mt-3">
        <label for="comment" class="form-label">Comments</label>
        <textarea
          name="review[comment]"
          id="comment"
          cols="30"
          rows="5"
          class="form-control"
          required
        ></textarea>
        <div class="invalid-feedback">Please add some comment for review</div>
      </div>
      <button class="btn btn-outline-dark">Submit</button>
    </form>
    <!-- <hr /> -->
    <% } %> <% if (listing.reviews.length > 0) { %>
    <div class="row mt-3">
      <p><b>All Reviews</b></p>
      <% for(review of listing.reviews) { %>
      <div class="card col-5 ms-3 mb-3">
        <div class="card-body mb-3">
          <h5 class="card-title">@<%= review.author.username %></h5>
          <p
            class="starability-result card-text"
            data-rating="<%= review.rating %>"
          ></p>
          <p class="card-text"><%= review.comment %></p>
        </div>
        <form
          class="mb-3"
          method="POST"
          action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE"
        >
          <button class="btn btn-sm btn-dark">Delete</button>
        </form>
      </div>
      <% } %>
    </div>
    <% } %>
  </div>

  <div class="mb-3">
    <h3>Where you'll be</h3>
    <div id="map" style="width: 100%;"></div>
  </div>
</div> <!-- End of Left Column -->

<!-- Right Column: Booking Widget -->
<div class="col-12 col-md-4">
  <div class="card booking-card shadow-sm border-0 sticky-top" style="top: 20px; border-radius: 1rem; padding: 1.5rem;">
    <div class="card-body p-0">
      <h4 class="card-title fw-bold mb-4">
        &#8377;<%= listing.price.toLocaleString("en-IN") %> <span class="fs-6 fw-normal text-muted">night</span>
      </h4>

      <div class="border rounded-3 mb-3">
        <div class="d-flex border-bottom">
          <div class="p-2 w-50 border-end">
            <label class="form-label mb-0" style="font-size: 0.7rem; font-weight: 800;">CHECK-IN</label>
            <input type="date" class="form-control border-0 p-0 shadow-none bg-transparent" id="checkin" style="font-size: 0.9rem;">
          </div>
          <div class="p-2 w-50">
            <label class="form-label mb-0" style="font-size: 0.7rem; font-weight: 800;">CHECKOUT</label>
            <input type="date" class="form-control border-0 p-0 shadow-none bg-transparent" id="checkout" style="font-size: 0.9rem;">
          </div>
        </div>
        <div class="p-2">
          <label class="form-label mb-0" style="font-size: 0.7rem; font-weight: 800;">GUESTS</label>
          <select class="form-select border-0 p-0 shadow-none bg-transparent" style="font-size: 0.9rem;">
            <option value="1">1 guest</option>
            <option value="2">2 guests</option>
            <option value="3">3 guests</option>
            <option value="4">4 guests</option>
            <option value="5">5+ guests</option>
          </select>
        </div>
      </div>

      <button onclick="handleReservation(this)" class="btn w-100 fw-bold mb-3 add-btn text-white py-2" style="border-radius: 0.5rem;">Reserve</button>

      <div class="text-center text-muted mb-3" style="font-size: 0.9rem;">You won't be charged yet</div>

      <div id="price-breakdown" class="d-none">
        <div class="d-flex justify-content-between mb-2 text-muted" style="font-size: 1rem;">
          <span class="text-decoration-underline" id="price-calculation">&#8377;<%= listing.price.toLocaleString("en-IN") %> x <span id="nights-count">0</span> nights</span>
          <span id="subtotal">&#8377;0</span>
        </div>
        <div class="d-flex justify-content-between mb-2 text-muted" style="font-size: 1rem;">
          <span class="text-decoration-underline">Cleaning fee</span>
          <span>&#8377;500</span>
        </div>
        <div class="d-flex justify-content-between mb-3 text-muted" style="font-size: 1rem;">
          <span class="text-decoration-underline">Service fee</span>
          <span id="service-fee">&#8377;0</span>
        </div>
        <hr>
        <div class="d-flex justify-content-between fw-bold" style="font-size: 1.1rem;">
          <span>Total before taxes</span>
          <span id="total-price">&#8377;0</span>
        </div>
      </div>

    </div>
  </div>
</div>
</div> <!-- End of Row -->

<script>
  // Simple logic to calculate days and show price breakdown
  const checkinInput = document.getElementById('checkin');
  const checkoutInput = document.getElementById('checkout');
  const priceBreakdown = document.getElementById('price-breakdown');
  const nightsCountSpan = document.getElementById('nights-count');
  const subtotalSpan = document.getElementById('subtotal');
  const serviceFeeSpan = document.getElementById('service-fee');
  const totalPriceSpan = document.getElementById('total-price');

  const nightlyRate = <%= listing.price %>;

  function calculatePrice() {
    if(checkinInput.value && checkoutInput.value) {
      const start = new Date(checkinInput.value);
      const end = new Date(checkoutInput.value);
      const diffTime = end - start;
      const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
      
      if(diffDays > 0) {
        priceBreakdown.classList.remove('d-none');
        nightsCountSpan.textContent = diffDays;
        
        const subtotal = diffDays * nightlyRate;
        // Mock service fee as 12% of subtotal
        const serviceFee = Math.round(subtotal * 0.12);
        const total = subtotal + 500 + serviceFee; // +500 cleaning fee

        subtotalSpan.innerHTML = `&#8377;${subtotal.toLocaleString("en-IN")}`;
        serviceFeeSpan.innerHTML = `&#8377;${serviceFee.toLocaleString("en-IN")}`;
        totalPriceSpan.innerHTML = `&#8377;${total.toLocaleString("en-IN")}`;
      } else {
        priceBreakdown.classList.add('d-none');
      }
    }
  }

  checkinInput.addEventListener('change', calculatePrice);
  checkoutInput.addEventListener('change', calculatePrice);
  
  // Set min dates to prevent past booking
  const today = new Date().toISOString().split('T')[0];
  checkinInput.min = today;
  checkinInput.addEventListener('change', () => {
    checkoutInput.min = checkinInput.value;
  });

  // Reservation Feedback Logic
  function handleReservation(btn) {
    <% if (!currUser) { %>
      window.location.href = "/login";
      return;
    <% } %>

    if(!checkinInput.value || !checkoutInput.value) {
      alert("Please select your check-in and checkout dates to proceed!");
      return;
    }
    alert("Success! Your room has been successfully reserved. We look forward to hosting you!");
    btn.innerText = "Reserved!";
    btn.style.backgroundColor = "#28a745"; // Bootstrap success green color
    btn.classList.remove("add-btn");
    btn.disabled = true;
  }
</script>

<script src="/js/map.js"></script>
